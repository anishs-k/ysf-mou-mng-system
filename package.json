{
  "name": "mou-mng-system",
  "version": "0.0.0",
  "private": true,
  "description": "Centralised web platform for onboarding companies, capturing MOU commercial terms, and configuring scheme-wise trainee payroll across zones and plants.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "src/*",
    "tests/e2e"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:domain": "turbo run test --filter=@mou/domain",
    "test:integration": "turbo run test:integration",
    "test:ui": "turbo run test:ui",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "db:generate": "npm run db:generate --workspace=@mou/api",
    "db:migrate": "npm run db:migrate --workspace=@mou/api",
    "db:seed": "npm run db:seed --workspace=@mou/api"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
