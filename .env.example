# Copy the values you need into your shell or into a local .env file.
# .env is gitignored - never commit real credentials.

# Connection string for the docker-compose Postgres. Host port 5434 is used
# because 5432 and 5433 are already taken on the development machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/mou_mng_system

# Integration tests use their own database so they never truncate dev data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/mou_mng_system_test

# Input for the seeded ADMIN row (SPEC-01 section 11.2). The seed stores only a
# scrypt hash of this value; changing it and re-running db:seed only takes effect
# if the stored hash is missing or is not a hash of ours.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me

# Origin the API accepts credentialed requests from. In development the web app
# runs on Vite's port; in production it shares the origin behind nginx.
WEB_ORIGIN=http://localhost:5173

# Where the wizard's uploaded MOU PDFs live (SPEC-05 section 4), outside the web
# root. Defaults to <repo>/.data/uploads (gitignored) if unset.
UPLOAD_ROOT=./.data/uploads
