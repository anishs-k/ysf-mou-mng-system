# Copy the values you need into your shell or into a local .env file.
# .env is gitignored - never commit real credentials.
#
# Running everything via `docker compose up` (see docs/devenv.md, "Run
# everything via Docker")? Only ADMIN_USERNAME/ADMIN_EMAIL/ADMIN_PASSWORD and
# WEB_ORIGIN below are read from this file - docker-compose.yml sets
# DATABASE_URL, PORT and UPLOAD_ROOT itself for the api/web containers, since
# those must point at the `postgres` service by its compose network name, not
# at localhost:5434.

# Connection string for the docker-compose Postgres. Host port 5434 is used
# because 5432 and 5433 are already taken on the development machine. Only
# used when running @mou/api directly on the host (npm run dev) - the api
# *container* gets its own DATABASE_URL from docker-compose.yml instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/mou_mng_system

# Integration tests use their own database so they never truncate dev data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/mou_mng_system_test

# Input for the seeded ADMIN row (SPEC-01 section 11.2). The seed stores only a
# scrypt hash of this value; changing it and re-running db:seed only takes effect
# if the stored hash is missing or is not a hash of ours.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me

# Origin the API accepts credentialed requests from. In development the web app
# runs on Vite's port; in production it shares the origin behind nginx. Under
# docker-compose, this is the *web* container's own published port (default
# 8080, see MOU_WEB_PORT below) - not the api container's port. Must match the
# browser's origin exactly, including scheme and with no trailing slash, or the
# credentialed request is rejected by CORS.
WEB_ORIGIN=http://localhost:5173

# SameSite attribute on the session cookie. Leave unset (the default, `lax`)
# whenever the browser reaches the API on the same site as the web app: the
# docker-compose setup (nginx proxies /api, so there is one origin), and any
# custom domain where the two are subdomains of one registrable domain -
# app.example.com and api.example.com are same-site, so `lax` is correct and
# keeps its CSRF protection.
#
# Set to `none` ONLY when they are genuinely cross-site, which a platform's own
# generated hostnames force: *.up.railway.app is on the public suffix list, so
# two services there are cross-site and a `lax` cookie is never sent back,
# making login silently impossible. `none` implies Secure (applied
# automatically), so it requires HTTPS.
# SESSION_COOKIE_SAMESITE=none

# Where the wizard's uploaded MOU PDFs live (SPEC-05 section 4), outside the web
# root. Defaults to <repo>/.data/uploads (gitignored) if unset. Only used when
# running @mou/api directly on the host - the api container always uses
# /app/uploads (docker-compose.yml), backed by the named volume uploads_data
# so files survive a container restart.
UPLOAD_ROOT=./.data/uploads

# Optional: override the host ports docker-compose publishes the api and web
# containers on, if 3001/8080 are already taken on this machine.
# MOU_API_PORT=3001
# MOU_WEB_PORT=8080
