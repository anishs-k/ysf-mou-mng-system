{
  "name": "@mou/api",
  "version": "0.0.0",
  "private": true,
  "description": "Layer 1 backend service: the Drizzle schema and migrations over PostgreSQL, the authentication endpoints, and the master data HTTP API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth/password": {
      "types": "./dist/auth/password.d.ts",
      "default": "./dist/auth/password.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types \"src/**/*.unit.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --experimental-strip-types \"src/**/*.integration.test.ts\"",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "db:up": "docker-compose up -d --wait postgres",
    "db:down": "docker-compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --experimental-strip-types src/db/migrate.ts",
    "db:seed": "node --env-file=.env --experimental-strip-types src/db/seed/index.ts",
    "db:seed:demo": "node --env-file=.env --experimental-strip-types src/db/seed/demo.ts",
    "user:create": "node --env-file=.env --experimental-strip-types src/db/seed/create-user.ts"
  },
  "dependencies": {
    "@mou/domain": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "pdf-lib": "1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
