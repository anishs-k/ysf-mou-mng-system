{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness - matches tsconfig.base.json's intent (this file cannot
       extend it directly: base sets module/moduleResolution to NodeNext,
       which conflicts with Vite's own bundler mode above). A code-review
       fix: without `strict`, `strictNullChecks` is off, which silently
       breaks control-flow narrowing on a discriminated union whose
       discriminant is a boolean literal (`{ ok: true }` / `{ ok: false }`) -
       every `if (result.ok) {...} return result.message` pattern in this
       codebase (LoginResult, ApplyEditResult) was already correct code that
       a missing compiler flag was failing to type-check correctly. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
